<!DOCTYPE html>
<html>
  <head>
    <title>キーワード検索結果</title>
    <link rel='stylesheet' href='/stylesheets/style.css' />
    <style>
      .article {
        background-color: pink;
      }
    </style>

  </head>
  <body>
    <h1>キーワード検索結果「 <%= searchWord %>」</h1>

    <% result.forEach(post => { %>
      <div class="article">
        <h2><%= post.title %></h2>
        <p>投稿日：<%= post.date.toISOString().slice(0, 10) %></p>
        <p><%= post.article %></p>
      </div>
    <% }) %>
    <a href="/">戻る</a>
  </body>
</html>
